# ==============================================================================
# MASTER CONFIGURATION FOR PRODUCTION RAG DOCUMENT CHATBOT
# ==============================================================================

# GROQ LLM API KEY
# Replace with your actual Groq API key (starts with gsk_...)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# FASTAPI CORE AI BACKEND
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma
CACHE_DIR=./data/cache

# NODE.JS API GATEWAY
GATEWAY_PORT=3000
JWT_SECRET=super_secret_production_rag_key_change_in_prod_12345
CORS_ORIGIN=http://localhost:5173

# BACKGROUND TASK BROKER (CELERY / REDIS)
REDIS_URL=redis://localhost:6379/0

# EMBEDDINGS & RERANKER MODELS (Local HuggingFace, 0% API Cost)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_TOKEN=your_huggingface_token_here
